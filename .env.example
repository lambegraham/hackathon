# Server-only credentials. Copy this file to .env.local and fill in your keys.
GEMINI_API_KEY=
# Redeem your organizer's private coupon in Gradium Studio, then create a key:
# https://studio.gradium.ai/platform/api-keys
GRADIUM_API_KEY=

# Fast conversational turns; stronger model for the final coaching report.
GEMINI_CONVERSATION_MODEL=gemini-3.5-flash-lite
GEMINI_FEEDBACK_MODEL=gemini-3.1-pro-preview
# Optional legacy fallback for either role when its specific override is absent.
GEMINI_MODEL=gemini-3.8-flash
# Catalog voice from Gradium's REST guide; a saved Voice Design voice_id also works.
GRADIUM_VOICE_ID=YTpq7expH9539ERJ
# Optional Gradium Studio keyword-boost set IDs (STT vocabulary), one per scenario.
# Leave blank to transcribe without a boost set.
KEYWORD_BOOST_INTERVIEW=
KEYWORD_BOOST_RELATIONSHIP=
# Optional per-tonality voices (defaults in src/lib/tonality.ts):
# GRADIUM_VOICE_CALM=
# GRADIUM_VOICE_REASSURING=
# GRADIUM_VOICE_EMPATHIC=
# GRADIUM_VOICE_FRIENDLY=
# GRADIUM_VOICE_CONFIDENT=
# GRADIUM_VOICE_EXCITED=
# GRADIUM_VOICE_NEUTRAL=
# Wispr Flow org key. It stays on the server and is exchanged for a short-lived client token.
WISPR_API_KEY=
# Two-letter ISO 639-1 code. Wispr has no separate Swiss German code; de is the documented German setting.
WISPR_LANGUAGE=de
